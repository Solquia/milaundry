# Copy to .env and fill in from your Supabase project settings (Settings → API).
# EXPO_PUBLIC_* vars are embedded in the app bundle — anon key only, never the
# service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Host of the public web pages (https://<host>/s/<shop-slug>). Printed into
# every counter QR, so change it before the first print, not after. Defaults
# to milaundry.app when unset.
EXPO_PUBLIC_WEB_HOST=milaundry.app

# ── ImageKit ────────────────────────────────────────────────────────────
# Images (shop logos and covers, weigh photos, payment receipts) are stored in
# ImageKit, not Supabase Storage. The app bundle holds NO ImageKit credential:
# it asks the `imagekit-media` Edge Function for a one-use upload token, and
# that function is the only place the private key exists. So these are Supabase
# function secrets, NOT EXPO_PUBLIC_ vars — do not add them to .env:
#
#   supabase secrets set \
#     IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxxxx \
#     IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxxx \
#     IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
