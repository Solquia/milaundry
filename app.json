{
  "expo": {
    "name": "MiLaundry3.0",
    "slug": "milaundry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "milaundry",
    "userInterfaceStyle": "light",
    "backgroundColor": "#04203F",
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#04203F"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.milaundry.app",
      "associatedDomains": [
        "applinks:milaundry.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.milaundry.app",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "<ANDROID_MAPS_KEY>"
        }
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "milaundry.app",
              "pathPrefix": "/join/"
            },
            {
              "scheme": "https",
              "host": "milaundry.app",
              "pathPrefix": "/claim/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#04203F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "MiLaundry uses Bluetooth to print receipts on your shop's thermal printer."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MiLaundry uses the camera to scan laundry shop and order QR codes."
        }
      ],
      "expo-maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MiLaundry uses your location to place your shop's pin on the map."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5590276c-07eb-45d8-b1c3-ce071aa17afe"
      }
    },
    "owner": "hyansolquia"
  }
}
